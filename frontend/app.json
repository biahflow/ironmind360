{
  "expo": {
    "name": "IronMind 360",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.healthresetapp.qtqmks",
      "infoPlist": {
        "NSCameraUsageDescription": "Fotografe seu prato para analisar as calorias",
        "NSPhotoLibraryUsageDescription": "Escolha uma foto da refeição para analisar"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#070709"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.healthresetapp.qtqmks",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-image-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#070709"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
