# Ambiente local. Copie para .env e troque todos os valores antes de publicar.
APP_ENV=development
APP_NAME=IronMind 360 API
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Banco e filas locais
MONGO_URL=mongodb://mongo:27017
DB_NAME=ironmind360
REDIS_URL=redis://redis:6379/0

# Servico de ML preditivo (Fase 5). Token compartilhado entre api/worker e ml.
# Em producao: URL interna (nao-localhost) e token forte sao obrigatorios.
ML_SERVICE_URL=http://ml:8100
ML_SERVICE_TOKEN=local-only-ml-token-change-me
INFERENCE_CACHE_TTL=900

# Autenticacao: valor exclusivamente local, nunca reutilize em producao.
JWT_SECRET=local-only-change-me-with-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# S3/MinIO local
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=ironmind360
S3_ACCESS_KEY=ironmind-local
S3_SECRET_KEY=local-only-change-me
S3_REGION=us-east-1

# Producao deve usar KMS externo. O ambiente local permanece sem chave real.
ENCRYPTION_KEY_PROVIDER=local-disabled
S3_SSE_ALGORITHM=
S3_KMS_KEY_ID=

# SMTP capturado pelo Mailpit em desenvolvimento
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@ironmind.local
APP_PUBLIC_URL=http://localhost:8081

# Seed local opcional. Nao e habilitado automaticamente em producao.
ENABLE_DEMO_SEED=true
DEMO_EMAIL=demo@ironmind.app
DEMO_PASSWORD=LocalDemo123!
DEMO_NAME=Atleta Demo

# Integracoes externas opcionais; deixe vazias no desenvolvimento basico.
EMERGENT_LLM_KEY=
COACH_MODEL_PROVIDER=anthropic
COACH_MODEL_NAME=claude-sonnet-5
VISION_MODEL_PROVIDER=openai
VISION_MODEL_NAME=gpt-5.4
INTERVALS_BASE_URL=https://intervals.icu/api/v1

# ExerciseDB: usado APENAS pelo script offline de enriquecimento de midia
# (scripts/enrich_exercise_media.py). Nao e chamado em runtime. Os GIFs sao
# baixados uma vez e servidos pelo nosso proprio S3/MinIO.
# Provider "rapidapi" (host + key da RapidAPI) ou "exercisedb" (self-host/exercisedb.io).
EXERCISEDB_PROVIDER=rapidapi
EXERCISEDB_API_HOST=exercisedb.p.rapidapi.com
EXERCISEDB_API_KEY=
EXERCISEDB_BASE_URL=https://exercisedb.p.rapidapi.com

# Expo Web (perfil `web`)
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
